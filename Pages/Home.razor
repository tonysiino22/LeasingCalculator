@page "/"

<PageTitle>Leasing Calculator</PageTitle>

<div class="calculator">
    <h1>Leasing Calculator</h1>

    <div class="field">
        <label for="price">Vehicle price (CHF)</label>
        <input id="price" type="number" @bind="price" />
    </div>
    <div class="field">
        <label for="down">Down payment (CHF)</label>
        <input id="down" type="number" @bind="down" />
    </div>
    <div class="field">
        <label for="residual">Residual value (CHF)</label>
        <input id="residual" type="number" @bind="residual" />
    </div>
    <div class="field">
        <label for="rate">Interest rate (%)</label>
        <input id="rate" type="number" step="0.1" @bind="rate" />
    </div>
    <div class="field">
        <label for="months">Term (months)</label>
        <input id="months" type="number" @bind="months" />
    </div>

    <div class="result">
        <span>Monthly payment</span>
        <strong>CHF @Calc.LeasePayment(price, down, residual, rate, months)</strong>
    </div>
</div>

@code {
    decimal price = 40000, down = 5000, residual = 15000, rate = 3.9m;
    int months = 48;
}
